# Copy to `.env.local` and edit. Never commit a real `.env*` file.
#
# Base URL of the existing Express API (no trailing slash, no `/api` suffix).
#
# iOS Simulator / Android emulator on the same machine as the API:
#   the app auto-derives http://<your-lan-ip>:3000 from the Metro host when this
#   is unset, so you can usually leave it blank for local development.
#
# Physical device on the same Wi-Fi — use your machine's LAN IP, not localhost:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000
#
# Deployed API:
#   EXPO_PUBLIC_API_BASE_URL=https://homework.example.com
EXPO_PUBLIC_API_BASE_URL=
