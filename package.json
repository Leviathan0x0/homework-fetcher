{
  "name": "homework-fetcher",
  "version": "0.5.0",
  "description": "Clean, minimal, calm consumer homework dashboard",
  "homepage": "https://mmss64.vercel.app",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run check:bundle",
    "preview": "vite preview",
    "start": "node server.js",
    "lint": "eslint src server api test e2e scripts server.js drizzle.config.js vite.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:server && npm run test:frontend",
    "test:server": "node --test test/**/*.test.js",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "audit": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit && npm run audit:production"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
